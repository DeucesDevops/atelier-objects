{
  "name": "commerce-platform-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["services/api-gateway", "services/auth-service", "services/catalog-service", "services/order-service", "services/inventory-service", "shared/typescript"],
  "scripts": {
    "prebuild": "npm run build --workspace @commerce/events",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start:gateway": "npm --workspace @commerce/api-gateway run start:dev"
  },
  "engines": { "node": ">=20" }
}
