FROM node:22-alpine AS build
WORKDIR /app

ARG SERVICE

COPY package.json package-lock.json tsconfig.base.json ./
COPY shared/typescript/package.json shared/typescript/package.json
COPY services/api-gateway/package.json services/api-gateway/package.json
COPY services/auth-service/package.json services/auth-service/package.json
COPY services/catalog-service/package.json services/catalog-service/package.json
COPY services/order-service/package.json services/order-service/package.json
COPY services/inventory-service/package.json services/inventory-service/package.json
COPY services/web-app/package.json services/web-app/package.json
RUN npm ci

COPY shared/typescript shared/typescript
COPY services/${SERVICE} services/${SERVICE}
RUN npm run build --workspace @commerce/events \
    && npm run build --workspace @commerce/${SERVICE} \
    && npm prune --omit=dev

FROM node:22-alpine AS runtime
WORKDIR /app

RUN apk add --no-cache curl

ARG SERVICE
ENV NODE_ENV=production
ENV SERVICE_NAME=$SERVICE

COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/shared/typescript/package.json ./shared/typescript/package.json
COPY --from=build --chown=node:node /app/shared/typescript/dist ./shared/typescript/dist
COPY --from=build --chown=node:node /app/services/${SERVICE}/package.json ./services/${SERVICE}/package.json
COPY --from=build --chown=node:node /app/services/${SERVICE}/dist ./services/${SERVICE}/dist

USER node
CMD ["sh", "-c", "node services/${SERVICE_NAME}/dist/main.js"]
